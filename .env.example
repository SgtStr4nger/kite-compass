# ─── Kite Compass environment ───
# Copy to `.env` and fill in real values. NEVER commit `.env`.

# Secret used to sign admin auth tokens. Generate a long random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# If unset, the server falls back to an insecure dev default — set this in production.
AUTH_SECRET=

# Port the server listens on (serves both the API and the built frontend).
PORT=5000

# Node environment: "development" (Vite dev server) or "production" (serves built assets).
NODE_ENV=production

# Public base URL of the site (no trailing slash), e.g. https://kite-compass.com.
# Used for the sitemap.xml URLs and the robots.txt Sitemap: directive.
# Falls back to the request Host header when unset.
PUBLIC_URL=
