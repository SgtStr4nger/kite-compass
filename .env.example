# ─── Kite Compass environment ───
# Copy to `.env` and fill in real values. NEVER commit `.env`.

# Secret used to sign admin auth tokens. Generate a long random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# If unset, the server falls back to an insecure dev default — set this in production.
AUTH_SECRET=

# Port the server listens on (serves both the API and the built frontend).
PORT=5000

# Node environment: "development" (Vite dev server) or "production" (serves built assets).
NODE_ENV=production
